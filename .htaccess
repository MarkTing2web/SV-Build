RewriteRule ^which-is-better-wired-or-wireless-alarm/?$ /systems/premises-security.html [R=301,L]
RewriteRule ^burglar-alarm-accessories/?$ /systems/premises-security.html [R=301,L]
RewriteRule ^burglar-alarm-services/?$ /systems/premises-security.html [R=301,L]

# CCTV
RewriteRule ^cctv-cameras-for-your-home-and-office/?$ /systems/premises-security.html [R=301,L]
RewriteRule ^ip-network-cctv/?$ /systems/premises-security.html [R=301,L]
RewriteRule ^ip-network-cctv/(.*)$ /systems/premises-security.html [R=301,L]
RewriteRule ^hd-analogue-cctv/?$ /systems/premises-security.html [R=301,L]
RewriteRule ^hd-analogue-cctv/(.*)$ /systems/premises-security.html [R=301,L]
RewriteRule ^analogue-cctv/?$ /systems/premises-security.html [R=301,L]
RewriteRule ^wired-or-wireless-cameras/?$ /systems/premises-security.html [R=301,L]
RewriteRule ^cctv-accessories/?$ /systems/premises-security.html [R=301,L]
