RewriteRule ^cctv-servicing/?$ /systems/premises-security.html [R=301,L]

# Door Access
RewriteRule ^door-access-for-office-and-building/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^single-door-access/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^multi-door-access/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^multi-door-access/(.*)$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^digital-door-locks/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^time-and-attendance/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^door-accessories/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^door-accessories/(.*)$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^door-access-servicing/?$ /systems/entry-access-control.html [R=301,L]

# Intercom & Phones
RewriteRule ^intercom-phone/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^residential-intercom/?$ /systems/entry-access-control.html [R=301,L]
RewriteRule ^apartment-intercom/?$ /solutions/condominiums/condominium-security-systems.html [R=301,L]
RewriteRule ^apartment-and-condominium-intercom/?$ /solutions/condominiums/condominium-security-systems.html [R=301,L]
RewriteRule ^commercial-intercom/?$ /solutions/commercial/office.html [R=301,L]
RewriteRule ^ip-phones-and-key-telephones/?$ /systems/ip-phone-communications.html [R=301,L]
RewriteRule ^intercom-servicing/?$ /systems/entry-access-control.html [R=301,L]

# Auto Gates & Barriers
RewriteRule ^auto-gates-and-barriers/?$ /systems/vehicle-lpr-management.html [R=301,L]
RewriteRule ^auto-gate-system/?$ /systems/vehicle-lpr-management.html [R=301,L]
RewriteRule ^car-park-barriers/?$ /systems/vehicle-lpr-management.html [R=301,L]
RewriteRule ^auto-gate-servicing/?$ /systems/vehicle-lpr-management.html [R=301,L]

# ============================================================
# UTILITY PAGE REDIRECTS
# ============================================================

RewriteRule ^about-us-security-solutions-provider/?$ /about.html [R=301,L]
RewriteRule ^about-us/?$ /about.html [R=301,L]
RewriteRule ^contact-us/?$ /contact.html [R=301,L]
RewriteRule ^contact-us-security-systems-servicing/?$ /contact.html [R=301,L]
RewriteRule ^security-enquiry-quote/?$ /request-site-assessment-singapore.html [R=301,L]
RewriteRule ^burglar-alarm-enquiry-quote/?$ /request-site-assessment-singapore.html [R=301,L]
RewriteRule ^cctv-system-enquiry-quote/?$ /request-site-assessment-singapore.html [R=301,L]
RewriteRule ^door-access-system-enquiry-quote/?$ /request-site-assessment-singapore.html [R=301,L]
RewriteRule ^intercom-phone-system-enquiry-quote/?$ /request-site-assessment-singapore.html [R=301,L]
RewriteRule ^auto-gates-and-car-park-barriers-enquiry-quote/?$ /request-site-assessment-singapore.html [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy.html [R=301,L]
RewriteRule ^terms-and-conditions/?$ /terms.html [R=301,L]
RewriteRule ^site-map/?$ /sitemap.html [R=301,L]
RewriteRule ^how-to-troubleshoot/?$ / [R=301,L]
RewriteRule ^featured-articles/?$ /insights/ [R=301,L]

# ============================================================
# OLD WORDPRESS PRODUCT PAGES
# No equivalent in new site — redirect to homepage
# ============================================================
RewriteRule ^\?p=.*$ / [R=301,L]

# ============================================================
# CLEAN URL HANDLING FOR NEW STATIC SITE
# Allows URLs without .html extension to resolve correctly
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# ============================================================
# 404 FALLBACK
# ============================================================
ErrorDocument 404 /404.html
