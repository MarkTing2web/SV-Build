# ============================================================
# OLD WORDPRESS PRODUCT PAGES
# No equivalent in new site — redirect to homepage
# ============================================================
RewriteRule ^\?p=.*$ / [R=301,L]

# ============================================================
# LEGACY WORDPRESS PDF REDIRECTS
# Old wp-content upload URLs → new library locations
# NC flag = case-insensitive matching
# ============================================================

# GE Caddx
RewriteRule ^wp-content/uploads/2021/09/GE-Caddx-NX8V2-Installation-Manual[^/]*\.pdf$ /resources/library/burglar-alarm/ge-caddx-nx8v2-installation-manual.pdf [R=301,L,NC]

# RISCO
RewriteRule ^wp-content/uploads/2021/09/LightSYS2-User-Manual[^/]*\.pdf$ /resources/library/burglar-alarm/risco-lightsys2-full-user-manual.pdf [R=301,L,NC]

# Ajax — files we have
RewriteRule ^wp-content/uploads/2021/09/Ajax-DoorProtect-User-Manual[^/]*\.pdf$ /resources/library/burglar-alarm/ajax-doorprotect-plus-user-manual.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/Ajax-Wireless-DoorProtect[^/]*\.pdf$ /resources/library/burglar-alarm/ajax-doorprotect-plus-user-manual.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/Ajax-Hub-Plus-User-Manual[^/]*\.pdf$ /resources/library/burglar-alarm/ajax-hub-2-plus-user-manual.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/AJAX-HUB-Plus-control-Panel-brochure[^/]*\.pdf$ /resources/library/burglar-alarm/ajax-hub-2-brochure.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/Ajax-MotionProtect-detector-brochure[^/]*\.pdf$ /resources/library/burglar-alarm/ajax-motioncam-outdoor-brochure.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/AJAX-Product-brochure[^/]*\.pdf$ /resources/library/burglar-alarm/ajax-hub-2-brochure.pdf [R=301,L,NC]

# Ajax — no file yet, send to library page
RewriteRule ^wp-content/uploads/2021/09/Ajax-KeyPad-User-Manual[^/]*\.pdf$ /resources/library/burglar-alarm.html [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/Ajax-MotionProtect-User-Manual[^/]*\.pdf$ /resources/library/burglar-alarm.html [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/ajax-Panic-Button-brochure[^/]*\.pdf$ /resources/library/burglar-alarm.html [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/ajax-SpaceControl[^/]*\.pdf$ /resources/library/burglar-alarm.html [R=301,L,NC]
RewriteRule ^wp-content/uploads/2021/09/Ajax-StreetSiren[^/]*\.pdf$ /resources/library/burglar-alarm.html [R=301,L,NC]

# Aiphone — no file yet, send to intercom library page
RewriteRule ^wp-content/uploads/2021/12/AIphone-LEF-Series[^/]*\.pdf$ /resources/library/intercom.html [R=301,L,NC]


# ============================================================
# RESOURCE HUB REDIRECTS
# Catches folder-path requests and redirects to hub .html files
# Prevents 404 when users hit /resources/library/ instead of
# /resources/library.html (folder exists but has no index.html)
# ============================================================
RewriteRule ^resources/library/?$ /resources/library.html [R=301,L]
RewriteRule ^resources/guides/?$ /resources/guides.html [R=301,L]
RewriteRule ^resources/faq/?$ /resources/faq.html [R=301,L]
RewriteRule ^resources/calculators/?$ /resources/calculators.html [R=301,L]
RewriteRule ^resources/checklists/?$ /resources/checklists.html [R=301,L]
RewriteRule ^resources/training-videos/?$ /resources/training-videos.html [R=301,L]

# ============================================================
# LIBRARY SUB-PAGE REDIRECTS
# Each library category has both a .html file AND a same-named
# subfolder containing PDFs. LiteSpeed sees the folder first
# and returns 403. These rules redirect explicitly to the .html.
# ============================================================
RewriteRule ^resources/library/burglar-alarm/?$ /resources/library/burglar-alarm.html [R=301,L]
RewriteRule ^resources/library/access-control/?$ /resources/library/access-control.html [R=301,L]
RewriteRule ^resources/library/cctv/?$ /resources/library/cctv.html [R=301,L]
RewriteRule ^resources/library/intercom/?$ /resources/library/intercom.html [R=301,L]
RewriteRule ^resources/library/ip-telephony/?$ /resources/library/ip-telephony.html [R=301,L]
RewriteRule ^resources/library/network/?$ /resources/library/network.html [R=301,L]
RewriteRule ^resources/library/platform/?$ /resources/library/platform.html [R=301,L]
RewriteRule ^resources/library/vehicle/?$ /resources/library/vehicle.html [R=301,L]

# ============================================================
# CLEAN URL HANDLING FOR NEW STATIC SITE
# Allows URLs without .html extension to resolve correctly
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# ============================================================
# 404 FALLBACK
# ============================================================
ErrorDocument 404 /404.html
